[0.012, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;30r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[?1h\u001b="]
[0.070, "o", "\u001b[H\u001b[2J\u001b[4d\u001b(B\u001b[0;4mKerkerkruip\u001b(B\u001b[m has a mode optimised for those using a screen reader.\r\u001b[6d"]
[0.000, "o", "\u001b(B\u001b[0;1mEnable\u001b(B\u001b[m the screen reader mode? Please enter:  \u001b(B\u001b[0;1mY\u001b(B\u001b[mes or \u001b(B\u001b[0;1mN\u001b(B\u001b[mo\r\u001b[8d"]
[0.000, "o", "This option, as well as other interface options, can be changed later from the Options menu.\r\u001b[12d"]
[2.435, "o", "\u001b[H\u001b(B\u001b[0;1mKerkerkruip\u001b(B\u001b[m -- by Victor Gijsbers\r\u001b[3d "]
