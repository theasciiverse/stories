[0.000, "o", "\u001b[7M\u001b[1;94H"]
[0.000, "o", "\u001b(B\u001b[0;7m\u001b[37m\u001b[40m2\r\u001b[24d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mYou are carrying:\u001b[25;3H"]
[0.000, "o", "a dashing hat (being worn)\u001b[26;3H"]
[0.000, "o", "a swordstick\u001b[27;5H"]
[0.000, "o", "a sword\u001b[28;3H"]
[0.000, "o", "a snuffbox (which is closed)\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
