[0.091, "o", "\u001b(B\u001b[0;1mo\u001b(B\u001b[m"]
[0.090, "o", "\u001b(B\u001b[0;1mr\u001b(B\u001b[m"]
[0.091, "o", "\u001b(B\u001b[0;1my\u001b(B\u001b[m"]
[0.093, "o", "\r\u001b[5d"]
[0.000, "o", "\u001b[3M\u001b[27dYou're carrying nothing. You are wearing some clothes.\r\u001b[29d"]
[0.000, "o", ">"]
[2.413, "o", "\u001b(B\u001b[0;1ms\u001b(B\u001b[m"]
[0.090, "o", "\u001b(B\u001b[0;1mo\u001b(B\u001b[m"]
[0.091, "o", "\u001b(B\u001b[0;1mu\u001b(B\u001b[m"]
[0.090, "o", "\u001b(B\u001b[0;1mt\u001b(B\u001b[m"]
[0.091, "o", "\u001b(B\u001b[0;1mh\u001b(B\u001b[m"]
[0.093, "o", "\r\u001b[5d"]
[0.000, "o", "\u001b[5M\u001b[25dYou could go anywhere, but you prefer it here, just for the sights.\r\u001b[27d"]
[0.000, "o", "Thunder rumbles from the horizon.\r\u001b[29d>"]
[2.413, "o", "\u001b(B\u001b[0;1mq\u001b(B\u001b[m"]
