[0.012, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;30r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[?1h\u001b="]
[0.013, "o", "\u001b[H\u001b[2J\u001b[1;46HShore\r\u001b[3dExits: \u001b(B\u001b[0;4mNone\r\u001b[4d"]
[0.000, "o", "\u001b(0\u001b[0mqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\u001b(B\u001b[8;1H\u001b(0\u001b[0m"]
[0.000, "o", "\u001b(BDown on the horizon, thunderstorms cloud the sky. But the sea is fresh, and the air has taken on\r\u001b[9d"]
[0.000, "o", "that orange hue.\r\u001b[11d"]
[0.000, "o", "It's just a \u001b(B\u001b[0;4mperfect\u001b(B\u001b[m day.\r\u001b[14d\u001b(B\u001b[0;1mShore\r\u001b[15d"]
[0.000, "o", "\u001b(B\u001b[mKorhos is setting. Its outer halo burns with no warmth. Loud waves splash on the sand half a dozen\r\u001b[16dmeters from your feet. The deep blue of the ocean steals a bit of the sky's orange glow.\r\u001b[18d"]
[0.000, "o", "The morning is brilliant.\r\u001b[20d"]
[0.000, "o", "You can see Uncle Oren here.\r\u001b[22d"]
[0.000, "o", "From the south, a thunderstorm is approaching.\r\u001b[24d\u001b(B\u001b[0;4m[First time players should type ABOUT or HELP for some important stuff about Interactive Fiction and\u001b[25;1H"]
[0.000, "o", "this game]\r\u001b[27d"]
[0.000, "o", "\u001b(B\u001b[m>"]
[2.474, "o", "\u001b(B\u001b[0;1m \u001b(B\u001b[m"]
