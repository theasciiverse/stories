[0.000, "o", "\r\u001b[10d"]
[0.001, "o", "\u001b[H\u001b(B\u001b[0;1mContent warning:\u001b(B\u001b[m\u001b[K\r\u001b[3d   [>>] Violenc\r\u001b[4d   [>>] Frequent crude language\r\u001b[5d   [>>] Rare mentions of suicide\r\u001b[7d\u001b(B\u001b[0;1mAnxiety warning:\u001b(B\u001b[m\u001b[K\r\u001b[9dThis game features an active antagonist, so your turns must be spent wisely!\r\u001b[11d\u001b(B\u001b[0;1mNote on randomness and UNDO:\r\u001b[13d\u001b(B\u001b[mElements of this game are randomized, with casual replayability in mind.  Use of \u001b(B\u001b[0;1mUNDO\u001b(B\u001b[m will not\r\u001b[14dchange the outcomes of randomized events.\r\u001b[16dRest assured that your survival is not decided by randomness.\r\u001b[18d"]
[0.000, "o", "[More]"]
