[0.002, "o", "\r\u001b[3d\u001b[M\u001b[29dDo you really want to quit?  (y/n)?\u001b[30;100H"]
[0.000, "o", "\r>\u001b[?12l\u001b[?25h"]
[2.617, "o", "\u001b[?25l"]
[0.000, "o", "y\u001b[?12l\u001b[?25h"]
[0.421, "o", "\u001b[?25l"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.001, "o", "\rThank you for playing!  Hope you come back soon!"]
