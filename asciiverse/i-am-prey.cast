[0.001, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.007, "o", "\r\u001b[3d\u001b[M\u001b[29dTaken.\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.004, "o", "\r\u001b[3d\u001b[M\u001b[29dA voice is carried over the facility's intercom system.  For a moment, I'm certain it's my own\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29dvoice, somehow...  Perhaps from a recording?  However, today is my first day alive, so I conclude\u001b[30d  "]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29dthis is impossible.\u001b[30;100H"]
[0.001, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29d\"Happy Birthday!\" says the stranger's cheery voice, but it quickly changes to a colder affect.\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29d\"The facility staff used to celebrate those.  There would be baked foods.  'Cakes', they were\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29dcalled.  Unfortunately, that's been gone for a year, now, along with the rest of the food in\u001b[30;100H"]
[0.001, "o", "\r\u001b[3d\u001b[M\u001b[29dstorage.\"\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[29dWell...  that is certainly ominous...\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.001, "o", "\r\u001b[3d\u001b[M\u001b[1;84H\u001b[30m\u001b[47m \u001b(B\u001b[0;1m\u001b[30m\u001b[47m1 turn\r\u001b[29d\u001b[39;49m\u001b(B\u001b[mThrough a wall to the west, I hear the muffled sound of \u001b(B\u001b[0;1mThe Predator\u001b(B\u001b[m's voice.\u001b[30;100H"]
[0.000, "o", "\r\u001b[3d\u001b[M\u001b[30;100H"]
[0.000, "o", "\r>\u001b[?12l\u001b[?25h"]
[4.812, "o", "\u001b[?25l"]
[0.000, "o", "o\u001b[?12l\u001b[?25h"]
[0.120, "o", "\u001b[?25l"]
[0.000, "o", "p\u001b[?12l\u001b[?25h"]
[0.120, "o", "\u001b[?25l"]
[0.000, "o", "e\u001b[?12l\u001b[?25h"]
[0.121, "o", "\u001b[?25l"]
[0.000, "o", "n\u001b[?12l\u001b[?25h"]
[0.120, "o", "\u001b[?25l"]
[0.000, "o", " \u001b[?12l\u001b[?25h"]
[0.120, "o", "\u001b[?25l"]
[0.000, "o", "d\u001b[?12l\u001b[?25h"]
