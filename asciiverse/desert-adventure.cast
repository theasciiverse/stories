[0.000, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;30r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[H\u001b[2J"]
[0.000, "o", "I'm in a hot and dry desert.\r\u001b[3d"]
[0.000, "o", "Obvious exits: North, South, East, West.\r\u001b[5d"]
[0.000, "o", "I can also see: Oasis to the north"]
[0.000, "o", "\r\u001b[15dScott Free, A Scott Adams game driver in C.\r\u001b[16d"]
[0.000, "o", "Release 1.14, (c) 1993,1994,1995 Swansea University Computer Society.\r\u001b[17d"]
[0.000, "o", "Distributed under the GNU software license\r\u001b[19d"]
[0.000, "o", "Desert Adventure by Sam Trenholme http://www.samiam.org/ September 2007.  Type\r\u001b[20d"]
[0.000, "o", "in \"COPY\" for copyright and copying terms.\r\u001b[22d"]
[0.000, "o", "For a list of verbs, type in \"VERBS\".\r\u001b[24dTell me what to do ? "]
