[0.000, "o", "\u001b(B\u001b[0;7m\u001b[37m\u001b[40m3\r\u001b[26d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mThe stars are no doubt on the ceiling there, but you can't really see them unless it's dark.\r\u001b[28d"]
[0.000, "o", "MUEAAAAAHA THE PAGER THE PAGER THE PAGER MAKE IT STOP\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
