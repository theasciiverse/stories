[0.000, "o", "\u001b[6M\u001b[2;96H"]
[0.000, "o", "\u001b(B\u001b[0;7m\u001b[37m\u001b[40m5\r\u001b[25d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mYou are carrying your pager and your key.\r\u001b[27d"]
[0.000, "o", "You return to lucidity for what is going to be a very brief moment, unless you make the pager stop\r\u001b[28d"]
[0.000, "o", "buzzing and vibrating.\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
