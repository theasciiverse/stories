[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mYou get off the couch.\r\u001b[28d"]
[0.000, "o", "THE PAGER IT HURTS US IT HURTS US AAAAAHEHEHEE\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
