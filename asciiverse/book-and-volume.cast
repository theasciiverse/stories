[0.000, "o", "\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[2.495, "o", "\u001b[H\u001b[37m\u001b[40m\u001b[K\u001b[2d"]
[0.000, "o", "\u001b[K\u001b[3d\u001b[K\u001b[4d"]
