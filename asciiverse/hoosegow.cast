[0.000, "o", "\u001b[5M\u001b[26d"]
[0.000, "o", "\u001b[37m\u001b[40mYou can ASK someone ABOUT something or SHOW something TO someone.\r\u001b[28d"]
[0.000, "o", "Muddy cracks his knuckles loudly.\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[2.413, "o", "\u001b[37m\u001b[40me\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
