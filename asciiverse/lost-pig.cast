[0.000, "o", "\u001b[4M\u001b[27d"]
[0.000, "o", "\u001b[37m\u001b[40mGrunk not allowed in field. That probably OK, because Grunk not think pig tall enough to climb over\r\u001b[28d"]
[0.000, "o", "wall.\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
