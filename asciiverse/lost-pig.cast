[0.090, "o", "\u001b[37m\u001b[40mt\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\u001b[37m\u001b[40me\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.090, "o", "\u001b[37m\u001b[40mn\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\r\u001b[21d\u001b[37m\u001b[40mGrunk get quiet. Listen for noise in dark.\r\u001b[23d"]
[0.000, "o", "Grunk hear noise! It come from some place in bushes, but Grunk not sure which way it come from.\r\u001b[25d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[2.413, "o", "\u001b[37m\u001b[40me\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\u001b[37m\u001b[40ma\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.090, "o", "\u001b[37m\u001b[40ms\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\u001b[37m\u001b[40mt\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\r\u001b[26d\u001b[37m\u001b[40mForest look dark. Pig probably some place in there, but Grunk not know which way to go. Not want end\u001b[27;1H"]
[0.000, "o", "up lost in forest with no pig.\r\u001b[29d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
