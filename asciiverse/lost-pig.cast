[0.090, "o", "\u001b[37m\u001b[40mk\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\r\u001b[2d"]
[0.001, "o", "\u001b[6M\u001b[25d\u001b(B\u001b[0;1m\u001b[37m\u001b[40mOutside\r\u001b[26d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mIt night time, and Grunk see moon up in sky. There forest to east and north. It even darker there,\r\u001b[27d"]
[0.000, "o", "and Grunk hear lots of strange animal. West of Grunk, there big field with little stone wall. Farm\r\u001b[28d"]
[0.000, "o", "back to south.\r\u001b[30d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
