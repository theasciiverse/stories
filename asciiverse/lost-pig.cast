[0.013, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;30r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[?1h\u001b="]
[0.000, "o", "\u001b[39;49m\u001b[39;49m\u001b[37m\u001b[40m\u001b[H\u001b[2J\u001b[21d\u001b[37m\u001b[40m\u001b[J\u001b[H"]
[0.000, "o", "\u001b(B\u001b[0;7m\u001b[37m\u001b[40m Outside                                                                              Score: 0      \u001b[5;1H\u001b(B\u001b[0m\u001b[37m\u001b[40mPig lost! Boss say that it Grunk fault. Say Grunk forget about closing gate. Maybe boss right. Grunk\u001b[6;1Hnot remember forgetting, but maybe Grunk just forget. Boss say Grunk go find pig, bring it back. Him\u001b[7;1H"]
[0.000, "o", "say, if Grunk not bring back pig, not bring back Grunk either. Grunk like working at pig farm, so\r\u001b[8dnow Grunk need find pig.\r\u001b[10d"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[37m\u001b[40mLost Pig\r\u001b[11d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mAnd Place Under Ground\r\u001b[12d"]
[0.000, "o", "Release 2 / Serial number 080406 / Inform v6.30 6/11 / ZCODE-1-070917-994E\r\u001b[13d"]
[0.000, "o", "(For help, use \"HELP\".)\r\u001b[15d\u001b(B\u001b[0;1m\u001b[37m\u001b[40mOutside\r\u001b[16d"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40mGrunk think that pig probably go this way. It hard to tell at night time, because moon not bright as\u001b[17;1H"]
[0.000, "o", "sun. There forest to east and north. It even darker there, and Grunk hear lots of strange animal.\r\u001b[18d"]
[0.000, "o", "West of Grunk, there big field with little stone wall. Farm back to south.\r\u001b[20d>\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[2.504, "o", "\u001b[37m\u001b[40ml\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\u001b[37m\u001b[40mi\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
