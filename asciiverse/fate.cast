[0.091, "o", "\u001b[37m\u001b[40mt\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.090, "o", "\u001b[37m\u001b[40mo\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\u001b[37m\u001b[40mr\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.090, "o", "\u001b[37m\u001b[40my\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.093, "o", "\r\u001b[2d"]
[0.000, "o", "\u001b[8M\u001b[23d\u001b[37m\u001b[40mYou are carrying:\u001b[24;3H"]
[0.000, "o", "a velvet pouch (closed)\u001b[25;3Ha scarlet gown (being worn)\r\u001b[27d"]
[0.000, "o", "Sharp bolts of pain move through your legs. \"I'd rather fight in battle thrice than give birth\r\u001b[28donce,\" you quote an ancient play.\r\u001b[30d>"]
[0.000, "o", "\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
