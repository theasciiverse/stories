[0.091, "o", "\r\u001b[2d"]
[0.000, "o", "\u001b[M\u001b[30d"]
[0.000, "o", "\u001b[37m\u001b[40mAre you sure you want to quit? \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[1.025, "o", "\u001b[37m\u001b[40my\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.091, "o", "\r\u001b[2d"]
[0.000, "o", "\u001b[2M\u001b[30d\u001b[37m\u001b[40m[Hit any key to exit.]\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[?25l"]
[1.025, "o", "\u001b[?12l\u001b[?25h"]
[0.000, "o", "\r\u001b[2d"]
