[0.000, "o", "7.7\r\u001b[25d\u001b(B\u001b[0;1mLiving Room\r\u001b[26d"]
[0.000, "o", "\u001b(B\u001b[mWhere the heavy drapes meet, a sliver of sunlight shines into the otherwise dark living room. A\r\u001b[27d"]
[0.000, "o", "framed picture hangs on the living room wall in the small area illuminated by the shaft of light.\r\u001b[29d"]
[0.000, "o", ">"]
