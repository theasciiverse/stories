[0.090, "o", "e"]
[0.091, "o", "\r\u001b[2d"]
[0.000, "o", "\u001b[3M\u001b[28d"]
[0.000, "o", "Nothing happens.\r\u001b[30d>"]
[2.413, "o", "s"]
[0.090, "o", "o"]
[0.091, "o", "u"]
[0.091, "o", "t"]
[0.090, "o", "h"]
