[0.000, "o", "\u001b[7M\u001b[1;3H"]
[0.000, "o", "\u001b(B\u001b[0;7mMouth of Alley\r\u001b[25d\u001b(B\u001b[0;1mMouth of Alley\r\u001b[26d"]
[0.000, "o", "\u001b(B\u001b[mYou're in the entrance of a narrow brick alley, which runs further in to the north. To the south a\r\u001b[27dbroad street courses by, congested with traffic and bicycles, although none of them seem to notice\r\u001b[28d"]
[0.000, "o", "you.\r\u001b[30d>"]
