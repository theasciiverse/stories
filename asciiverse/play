#!/bin/sh
# Starts a story from an av install: the interpreter in lib/ plays the story
# file next to this script, picked by its extension (Z-machine with Frotz,
# Glulx with Glulxe, TADS with FrobTADS, Scott Adams .dat with ScottFree).
# Saved games go to ~/.local/share/<story>, outside the install folder (av
# replaces that on updates). The story is named after this script.
# av links ~/.local/bin/<story> to this file, so follow that link first.
self=$(readlink "$0" 2>/dev/null || printf '%s' "$0")
dir=$(cd "$(dirname "$self")" && pwd)
story=$(basename "$self")
saves="${XDG_DATA_HOME:-$HOME/.local/share}/$story"
for f in "$dir"/*.z[1-8] "$dir"/*.zblorb "$dir"/*.ulx "$dir"/*.gblorb "$dir"/*.t3 "$dir"/*.gam "$dir"/*.dat; do
  [ -f "$f" ] && break
done
[ -f "$f" ] || { echo "$story: no story file in $dir" >&2; exit 1; }
mkdir -p "$saves" && cd "$saves" || exit 1
case "$f" in
  *.ulx|*.gblorb) exec "$dir/lib/glulxe" "$@" "$f" ;;
  *.t3|*.gam)     exec "$dir/lib/frob" -d "$@" "$f" ;;  # -d: saves here, not by the story
  *.dat)
    # ScottFree restores only from its command line (scottfree <story>
    # <saved game>), so offer the saved games here
    restore=
    if [ -t 0 ] && [ -n "$(ls -A . 2>/dev/null)" ]; then
      echo "Saved games:"; ls -1t .
      printf 'Name of the saved game to restore (Enter for a new game): '
      read -r restore || restore=
      [ -n "$restore" ] && [ ! -f "$restore" ] && { echo "No saved game called $restore; starting a new game."; restore=; sleep 1; }
    fi
    exec "$dir/lib/scottfree" "$@" "$f" ${restore:+"$restore"} ;;
  *)              exec "$dir/lib/frotz" "$@" "$f" ;;
esac
